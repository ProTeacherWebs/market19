{
  "expo": {
    "name": "Velin",
    "slug": "velin",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "velin",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#08090b"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.velin.market"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08090b"
      },
      "package": "uz.velin.market",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "velin",
              "host": "p",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
