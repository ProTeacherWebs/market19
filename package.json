{
  "name": "market",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @market/web",
    "build": "npm run build -w @market/web",
    "lint": "npm run lint -w @market/web",
    "test": "npm test -w @market/data",
    "format": "prettier --write \"apps/web/src/**/*.{ts,tsx,css}\" \"packages/**/*.ts\""
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
