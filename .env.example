# Public site URL for sitemap/OG
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Data layer: neon (stage B) | mock (unit tests / offline)
DATA_SOURCE=neon

# Neon (filled by `neon deploy` / `neon env pull`)
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# NEON_BRANCH=production
# NEON_AUTH_BASE_URL=
# NEON_AUTH_JWKS_URL=
# NEON_FUNCTION_HELLO_BASE_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=
# NEON_STORAGE_BUCKET=assets

# Cookie secret for Managed Better Auth (min 32 chars)
# NEON_AUTH_COOKIE_SECRET=
# AUTH_SECRET=

# Google OAuth (own app). In Google Cloud Console redirect URI must be:
#   {NEON_AUTH_BASE_URL}/callback/google
# NOT the Next.js /api/auth/google/callback path.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Telegram Mini App (stage C)
# BotFather token — server only; used to HMAC-verify WebApp initData
# TELEGRAM_BOT_TOKEN=
# Optional dedicated secret for Mini App Bearer tokens (falls back to AUTH_SECRET)
# TELEGRAM_SESSION_SECRET=
# CORS origins for apps/telegram (comma-separated). Default: http://localhost:5173
# TELEGRAM_MINIAPP_ORIGIN=http://localhost:5173

# Expo mobile uses EXPO_PUBLIC_API_BASE_URL in apps/mobile/.env (same Neon API as site)


